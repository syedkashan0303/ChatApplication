<!-- User Profile Modal -->
<style>
    .ArbabTheme #userProfileModal .modal-content {
        background-color: #18191a !important;
        border: 1px solid #3a3b3c !important;
        color: #e4e6eb;
    }
    .ArbabTheme #userProfileModal .nav-pills {
        background-color: #242526 !important;
        border-color: #3a3b3c !important;
    }
    .ArbabTheme #userProfileModal .nav-pills .nav-link {
        color: #b0b3b8;
    }
    .ArbabTheme #userProfileModal .nav-pills .nav-link.active {
        background-color: #3a3b3c !important;
        color: #ffffff !important;
    }
    .ArbabTheme #userProfileModal .input-group-text {
        background-color: #242526 !important;
        border-color: #3a3b3c !important;
        color: #b0b3b8 !important;
    }
    .ArbabTheme #userProfileModal .form-control {
        background-color: #18191a !important;
        border-color: #3a3b3c !important;
        color: #e4e6eb !important;
    }
    .ArbabTheme #userProfileModal .form-control:disabled,
    .ArbabTheme #userProfileModal .form-control[readonly] {
        background-color: #242526 !important;
        color: #90949c !important;
    }
</style>

<div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            
            <!-- Modal Header -->
            <div class="modal-header border-0 text-white px-4 py-3" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <div class="d-flex align-items-center">
                    <div class="avatar-circle me-3 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white shadow-sm" style="width: 45px; height: 45px; font-size: 20px;">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0" id="userProfileModalLabel" style="font-size: 1.15rem; letter-spacing: 0.3px;">
                            User Profile & Settings
                        </h5>
                        <small class="text-white-50" style="font-size: 0.82rem;">Manage your personal account information and security</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4">
                
                <!-- Nav Tabs -->
                <ul class="nav nav-pills nav-justified mb-4 p-1 bg-light rounded-3 border" id="profileTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold py-2 rounded-2" id="details-tab" data-bs-toggle="tab" data-bs-target="#details-tab-pane" type="button" role="tab" aria-controls="details-tab-pane" aria-selected="true">
                            <i class="fa-solid fa-address-card me-2"></i>Profile Details
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold py-2 rounded-2" id="password-tab" data-bs-toggle="tab" data-bs-target="#password-tab-pane" type="button" role="tab" aria-controls="password-tab-pane" aria-selected="false">
                            <i class="fa-solid fa-shield-halved me-2"></i>Change Password
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="profileTabContent">
                    
                    <!-- Tab 1: Profile Details -->
                    <div class="tab-pane fade show active" id="details-tab-pane" role="tabpanel" aria-labelledby="details-tab" tabindex="0">
                        <form id="profileForm" onsubmit="event.preventDefault(); updateUserProfile();">
                            <div class="row g-3">
                                
                                <!-- Full Name -->
                                <div class="col-md-6">
                                    <label for="profileFullName" class="form-label fw-semibold text-secondary small mb-1">
                                        Full Name <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-user-pen"></i></span>
                                        <input type="text" class="form-control border-start-0 ps-0" id="profileFullName" placeholder="Enter full name" required />
                                    </div>
                                    <span class="text-danger small mt-1 d-block" id="err-FullName"></span>
                                </div>
                                
                                <!-- Phone Number -->
                                <div class="col-md-6">
                                    <label for="profilePhoneNumber" class="form-label fw-semibold text-secondary small mb-1">
                                        Phone Number
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-phone"></i></span>
                                        <input type="tel" class="form-control border-start-0 ps-0" id="profilePhoneNumber" placeholder="Enter phone number" maxlength="15" />
                                    </div>
                                    <span class="text-danger small mt-1 d-block" id="err-PhoneNumber"></span>
                                </div>

                                <!-- Username (Disabled) -->
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="profileUserName" class="form-label fw-semibold text-secondary small mb-0">Username</label>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 bg-white" style="font-size: 0.7rem;"><i class="fa-solid fa-lock me-1"></i>Read-Only</span>
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-at"></i></span>
                                        <input type="text" class="form-control bg-light border-start-0 ps-0 text-muted" id="profileUserName" readonly disabled />
                                    </div>
                                </div>

                                <!-- Email (Disabled) -->
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="profileEmail" class="form-label fw-semibold text-secondary small mb-0">Email Address</label>
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 bg-white" style="font-size: 0.7rem;"><i class="fa-solid fa-lock me-1"></i>Read-Only</span>
                                    </div>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                                        <input type="email" class="form-control bg-light border-start-0 ps-0 text-muted" id="profileEmail" readonly disabled />
                                    </div>
                                </div>
                            </div>

                            <div class="pt-2 d-flex justify-content-end align-items-center border-top">
                                <button type="button" class="btn btn-light px-4 me-2 border" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary px-4 shadow-sm" id="btnSaveProfile">
                                    <i class="fa-solid fa-check me-1"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Tab 2: Change Password -->
                    <div class="tab-pane fade" id="password-tab-pane" role="tabpanel" aria-labelledby="password-tab" tabindex="0">
                        <form id="changePasswordForm" onsubmit="event.preventDefault(); changeUserPassword();">
                            <div class="row g-3">
                                
                                <!-- New Password -->
                                <div class="col-md-6">
                                    <label for="profileNewPassword" class="form-label fw-semibold text-secondary small mb-1">
                                        New Password <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-key"></i></span>
                                        <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="profileNewPassword" autocomplete="new-password" placeholder="Min. 8 characters" required />
                                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility('profileNewPassword', this)">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    </div>
                                    <span class="text-danger small mt-1 d-block" id="err-NewPassword"></span>
                                </div>

                                <!-- Confirm Password -->
                                <div class="col-md-6">
                                    <label for="profileConfirmPassword" class="form-label fw-semibold text-secondary small mb-1">
                                        Confirm New Password <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-check-double"></i></span>
                                        <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="profileConfirmPassword" autocomplete="new-password" placeholder="Re-enter new password" required />
                                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility('profileConfirmPassword', this)">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    </div>
                                    <span class="text-danger small mt-1 d-block" id="err-ConfirmPassword"></span>
                                </div>
                            </div>

                            <div class="pt-2 d-flex justify-content-end align-items-center border-top">
                                <button type="button" class="btn btn-light px-4 me-2 border" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger px-4 shadow-sm" id="btnSavePassword">
                                    <i class="fa-solid fa-key me-1"></i> Update Password
                                </button>
                            </div>
                        </form>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modalElement = document.getElementById('userProfileModal');
        if (modalElement) {
            modalElement.addEventListener('show.bs.modal', function () {
                clearProfileErrors();
                clearPasswordErrors();
                loadUserProfile();
            });
        }
    });

    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function clearProfileErrors() {
        $('#err-FullName').text('');
        $('#err-PhoneNumber').text('');
    }

    function clearPasswordErrors() {
        $('#err-NewPassword').text('');
        $('#err-ConfirmPassword').text('');
    }

    function loadUserProfile() {
        $.ajax({
            url: '@Url.Action("GetUserProfile", "Account")',
            type: 'GET',
            contentType: 'application/json',
            success: function (res) {
                if (res.success) {
                    $('#profileFullName').val(res.fullName || '');
                    $('#profileEmail').val(res.email || '');
                    $('#profileUserName').val(res.userName || '');
                    $('#profilePhoneNumber').val(res.phoneNumber || '');
                } else {
                    if (typeof toastr !== 'undefined') {
                        toastr.error(res.message || "Failed to load user profile.");
                    }
                }
            },
            error: function () {
                if (typeof toastr !== 'undefined') {
                    toastr.error("Error connecting to server while loading profile.");
                }
            }
        });
    }

    function updateUserProfile() {
        clearProfileErrors();
        const btn = $('#btnSaveProfile');
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...');

        const payload = {
            fullName: $('#profileFullName').val(),
            phoneNumber: $('#profilePhoneNumber').val()
        };

        $.ajax({
            url: '@Url.Action("UpdateProfile", "Account")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Save Changes');
                if (res.success) {
                    if (typeof toastr !== 'undefined') {
                        toastr.success(res.message || "Profile updated successfully!");
                    }
                    if ($('#manage').length) {
                        $('#manage').text(res.fullName + '!');
                    }
                } else {
                    if (res.errors) {
                        $.each(res.errors, function (key, val) {
                            const errElement = $('#err-' + key);
                            if (errElement.length) {
                                errElement.text(val);
                            } else if (typeof toastr !== 'undefined') {
                                toastr.error(val);
                            }
                        });
                    } else if (res.message && typeof toastr !== 'undefined') {
                        toastr.error(res.message);
                    }
                }
            },
            error: function () {
                btn.prop('disabled', false).html('<i class="fa-solid fa-check me-1"></i> Save Changes');
                if (typeof toastr !== 'undefined') {
                    toastr.error("An error occurred while saving profile.");
                }
            }
        });
    }

    function changeUserPassword() {
        clearPasswordErrors();
        const btn = $('#btnSavePassword');
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Updating...');

        const payload = {
            newPassword: $('#profileNewPassword').val(),
            confirmPassword: $('#profileConfirmPassword').val()
        };

        $.ajax({
            url: '@Url.Action("ChangePassword", "Account")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                btn.prop('disabled', false).html('<i class="fa-solid fa-key me-1"></i> Update Password');
                if (res.success) {
                    if (typeof toastr !== 'undefined') {
                        toastr.success(res.message || "Password changed successfully!");
                    }
                    $('#changePasswordForm')[0].reset();
                } else {
                    if (res.errors) {
                        $.each(res.errors, function (key, val) {
                            const errElement = $('#err-' + key);
                            if (errElement.length) {
                                errElement.text(val);
                            } else if (typeof toastr !== 'undefined') {
                                toastr.error(val);
                            }
                        });
                    } else if (res.message && typeof toastr !== 'undefined') {
                        toastr.error(res.message);
                    }
                }
            },
            error: function () {
                btn.prop('disabled', false).html('<i class="fa-solid fa-key me-1"></i> Update Password');
                if (typeof toastr !== 'undefined') {
                    toastr.error("An error occurred while changing password.");
                }
            }
        });
    }
</script>
